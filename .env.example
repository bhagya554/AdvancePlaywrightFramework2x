# Environment configuration
# Consumed by src/config/ — do not commit real secrets

ENV=qa
BASE_URL=https://example.com
API_BASE_URL=https://api.example.com

# TTACart login — consumed by src/config/credentials.ts
# Do NOT name these USERNAME/PASSWORD: Windows already sets USERNAME for every
# process and dotenv never overwrites an existing key, so such a line is
# silently ignored.
STANDARD_USER=standard_user
TTA_SECRET=tta_secret

# Product under test for src/tests/e2e/e2e-checkout-env.spec.ts
TTA_ITEM_ID=test-allthethings-tshirt-red

# API auth
API_TOKEN=
